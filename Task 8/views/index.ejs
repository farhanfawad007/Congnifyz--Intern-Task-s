<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --border: #334155;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --success: #4ade80;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
    }
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
    header { margin-bottom: 2.5rem; }
    h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; }
    .subtitle { color: var(--muted); font-size: 0.95rem; }
    .badge {
      display: inline-block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      font-size: 0.8rem;
      color: var(--accent);
      margin-top: 0.75rem;
    }
    section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1.25rem;
    }
    h2 { font-size: 1.1rem; margin-bottom: 1rem; color: var(--accent); }
    p, li { color: var(--muted); font-size: 0.9rem; }
    ul { padding-left: 1.25rem; margin-top: 0.5rem; }
    li { margin-bottom: 0.35rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
    button {
      background: var(--accent);
      color: var(--bg);
      border: none;
      border-radius: 8px;
      padding: 0.6rem 1.1rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    button:hover { opacity: 0.85; }
    button.secondary {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--accent);
    }
    #output {
      margin-top: 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      font-family: 'Consolas', monospace;
      font-size: 0.8rem;
      white-space: pre-wrap;
      word-break: break-all;
      min-height: 80px;
      color: var(--success);
    }
    footer {
      margin-top: 2rem;
      text-align: center;
      color: var(--muted);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1><%= title %></h1>
      <p class="subtitle">Express · Redis · Bull · EJS — Cognifyz Task 8</p>
      <span class="badge">Server on port <%= port %></span>
    </header>

    <section>
      <h2>Middleware</h2>
      <ul>
        <li><strong>Body parsing</strong> — express.json() &amp; express.urlencoded()</li>
        <li><strong>Request logging</strong> — Morgan with timestamps &amp; response times</li>
        <li><strong>Global error handler</strong> — centralized error responses</li>
      </ul>
    </section>

    <section>
      <h2>Redis Caching</h2>
      <p>GET <code>/api/stats</code> simulates a heavy query. First request is a cache MISS; subsequent requests within 60s are served from Redis (X-Cache: HIT).</p>
      <div class="actions">
        <button onclick="fetchStats()">Fetch /api/stats</button>
      </div>
    </section>

    <section>
      <h2>Background Jobs (Bull)</h2>
      <p>Heavy tasks are offloaded to a separate worker process via Redis-backed queues.</p>
      <div class="actions">
        <button onclick="enqueueJob('email')">Queue Email Job</button>
        <button onclick="enqueueJob('report')" class="secondary">Queue Report Job</button>
        <button onclick="enqueueJob('file')" class="secondary">Queue File Job</button>
      </div>
    </section>

    <div id="output">Click a button to test an endpoint…</div>

    <footer>Cognifyz Internship — Task 8: Advanced Server-Side Functionality</footer>
  </div>

  <script>
    const output = document.getElementById('output');

    function show(data, headers) {
      const headerInfo = headers ? `\n\nHeaders: ${JSON.stringify(headers, null, 2)}` : '';
      output.textContent = JSON.stringify(data, null, 2) + headerInfo;
    }

    async function fetchStats() {
      output.textContent = 'Loading (may take ~800ms on cache miss)…';
      const res = await fetch('/api/stats');
      const data = await res.json();
      show(data, { 'X-Cache': res.headers.get('X-Cache') });
    }

    async function enqueueJob(type) {
      output.textContent = `Queuing ${type} job…`;
      const payloads = {
        email: { type: 'email', to: 'user@example.com', subject: 'Welcome!', body: 'Thanks for joining Cognifyz.' },
        report: { type: 'report', reportName: 'monthly-sales', rows: 50 },
        file: { type: 'file', fileName: 'export.json' },
      };
      const res = await fetch('/api/jobs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payloads[type]),
      });
      const data = await res.json();
      show(data);
    }
  </script>
</body>
</html>
