{
  "name": "cognifyz-task-8",
  "version": "1.0.0",
  "description": "Task 8: Advanced Server-Side Functionality with Express, Redis, Bull, and EJS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node queue/worker.js",
    "dev": "node --watch server.js",
    "dev:worker": "node --watch queue/worker.js",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down"
