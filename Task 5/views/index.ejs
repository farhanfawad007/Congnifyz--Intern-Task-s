<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <h1><%= title %></h1>
      <p class="subtitle">Manage items with RESTful API &amp; Fetch</p>
    </header>

    <!-- Notification banner -->
    <div id="notification" class="notification hidden" role="alert" aria-live="polite"></div>

    <!-- Item form -->
    <section class="card form-section">
      <h2 id="form-title">Add New Item</h2>
      <form id="item-form" novalidate>
        <input type="hidden" id="item-id" value="">
        <div class="form-group">
          <label for="item-name">Name <span class="required">*</span></label>
          <input type="text" id="item-name" placeholder="Enter item name" required>
        </div>
        <div class="form-group">
          <label for="item-description">Description</label>
          <textarea id="item-description" rows="2" placeholder="Enter item description"></textarea>
        </div>
        <div class="form-group">
          <label for="item-price">Price ($) <span class="required">*</span></label>
          <input type="number" id="item-price" step="0.01" min="0" placeholder="0.00" required>
        </div>
        <div class="form-actions">
          <button type="submit" id="submit-btn" class="btn btn-primary">Add Item</button>
          <button type="button" id="cancel-btn" class="btn btn-secondary hidden">Cancel</button>
        </div>
      </form>
    </section>

    <!-- Items list -->
    <section class="card list-section">
      <div class="list-header">
        <h2>All Items</h2>
        <span id="item-count" class="badge">0 items</span>
      </div>
      <div id="loading" class="loading">Loading items...</div>
      <div id="items-list" class="items-list"></div>
      <div id="empty-state" class="empty-state hidden">
        <p>No items found. Add your first item above!</p>
      </div>
    </section>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
